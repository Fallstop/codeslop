# git autocrlf=true converts LF to CRLF on Windows, causing issues with oxfmt
* text=auto eol=lf
# Batch files need CRLF for cmd.exe to parse them reliably.
*.cmd text eol=crlf
*.bat text eol=crlf
# Merges take the incoming lockfile; run `pnpm install` afterwards to regenerate it.
# The driver lives in local git config: git config merge.pnpm-lock.driver "cp %B %A"
pnpm-lock.yaml merge=pnpm-lock
# GitHub's GraphQL schema and the operations graphqlgen writes from it.
packages/source-control-github/schema/** linguist-generated
**/*.graphql.ts linguist-generated
